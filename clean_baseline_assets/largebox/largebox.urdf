<?xml version="1.0"?>
<robot name="largebox">
  <link name="largebox_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.002" ixy="0" ixz="0"
               iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <geometry><mesh filename="largebox.obj"/></geometry>
    </visual>
    <collision name="largebox">
      <geometry><mesh filename="largebox.obj"/></geometry>
    </collision>
  </link>
</robot>
